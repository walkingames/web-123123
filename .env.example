# Waitlist (/waitlist) — required to deliver signups.
# Resend: https://resend.com/api-keys
RESEND_API_KEY=

# Verified sender. Defaults to "Walkin Waitlist <onboarding@resend.dev>", which
# only works while the Resend account is unverified. Once walkingames.com is
# verified in Resend, point this at the domain (e.g. "Walkin Waitlist <waitlist@walkingames.com>").
WAITLIST_FROM_EMAIL=

# Google Identity Services, for the one-click "Continue with Google" join.
# https://console.cloud.google.com/apis/credentials — Authorisation: walkingames.com,
# type: Web application, authorised JS origin: https://walkingames.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=